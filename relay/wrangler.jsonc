{
  "name": "simpleton-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "*.simpleton.live/*",
      "zone_name": "simpleton.live"
    }
  ],
  "vars": {
    "SHARE_DOMAIN": "simpleton.live"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TUNNEL",
        "class_name": "Tunnel"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Tunnel"
      ]
    }
  ]
}